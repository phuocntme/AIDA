{
  "name": "@aida/contracts",
  "private": true,
  "author": "phuocntme",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "deploy:fuji": "set -a && . ../../.env.fuji && set +a && hardhat run scripts/deploy.ts --network fuji",
    "seed:fuji": "set -a && . ../../.env.fuji && set +a && ORACLE_URL=${ORACLE_URL:-http://127.0.0.1:8787} hardhat run scripts/seed.ts --network fuji",
    "bootstrap:fuji": "set -a && . ../../.env.fuji && set +a && hardhat run scripts/bootstrap-agents.ts --network fuji"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/hardhat-viem": "^3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.5",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/node": "^26.6.6",
    "hardhat": "3.21.2",
    "typescript": "^5.9.3",
    "viem": "2.57.19"
  },
  "dependencies": {
    "@aida/sdk": "workspace:^",
    "@openzeppelin/contracts": "5.6.1"
  }
}
